import os
from flask import Flask
from supabase import create_client, Client
from dotenv import load_dotenv

load_dotenv()

app = Flask(__name__)

supabase: Client = create_client(
    os.environ.get("SUPABASE_URL"),
    os.environ.get("SUPABASE_KEY")
)

@app.route('/')
def index():
    response = supabase.table('todos').select("*").execute()
    todos = response.data

    html = '<h1>Todos</h1><ul>'
    for todo in todos:
        html += f'<li>{todo["name"]}</li>'
    html += '</ul>'

    return html

if __name__ == '__main__':
    app.run(debug=True)
`}];return(0,t.jsx)(r.MultipleCodeBlock,{files:a})}])},84223,e=>{"use strict";var t=e.i(221628),r=e.i(486240);e.s(["default",0,({projectKeys:e})=>{let a=[{name:"lib/main.dart",language:"dart",code:`
