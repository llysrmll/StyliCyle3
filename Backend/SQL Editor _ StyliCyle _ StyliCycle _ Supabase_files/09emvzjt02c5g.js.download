import { createClient } from "@supabase/supabase-js";

const supabaseUrl = import.meta.env.VITE_SUPABASE_URL;
const supabaseKey = import.meta.env.${e.publishableKey?"VITE_SUPABASE_PUBLISHABLE_KEY":"VITE_SUPABASE_ANON_KEY"};

